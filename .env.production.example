# ==========================================
# ScoreLogic Production Environment Variables
# ==========================================

# Required: API-Sports / RapidAPI Football API Key
API_FOOTBALL_KEY=your_api_football_key_here

# Required: Groq Cloud API Key for AI Match Predictions & Bet Builder
GROQ_API_KEY=your_groq_api_key_here

# Optional: Port number (Defaults to 3000, or assigned automatically by cloud host e.g. Render/Heroku/Railway)
PORT=3000

# Optional: Node environment
NODE_ENV=production

# Optional: PostgreSQL Database URL (e.g. Neon, Supabase, Render Postgres)
# If omitted, the app will store data locally in SQLite (database.sqlite)
DATABASE_URL=postgres://user:password@host:port/database

# Optional: Timezone for background cron routines (default: Africa/Lagos)
CRON_TZ=Africa/Lagos

# Optional: GoalServe API Key (if using GoalServe feeds)
GOALSERVE_API_KEY=
